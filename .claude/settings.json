{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 -m compileall *)",
      "Bash(python3 -m unittest *)",
      "Bash(python -m compileall *)",
      "Bash(python -m unittest *)",
      "Bash(python3 harness/zeropw_harness.py doctor)",
      "Bash(sh harness/cloud_setup.sh)",
      "Bash(bash harness/cloud_setup.sh)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)"
    ],
    "deny": [
      "Read(./.zeropw-harness/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}

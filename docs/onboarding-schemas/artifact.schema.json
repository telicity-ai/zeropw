{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "release_tag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "enum": [
        "v0.2.0"
      ]
    },
    "archive_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "enum": [
        "68493ecb7bf5e47c6924bcbaee8dde994b8dde17acfa4c836522baacec6f8d5d",
        "5f1dc52a5081e3386f71843c51a7f15f5e95d1b13153c446e08975b0eba70d86"
      ]
    },
    "tap_commit": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "enum": [
        "human_verified_release"
      ]
    },
    "formula_sha256": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "1cc8493ac6964201eac9778ba591e285ddf8637926741aa475a43078c11830b6"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "release_tag",
    "archive_sha256",
    "tap_commit",
    "source",
    "formula_sha256"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "enum": [
        "zeropw-onboarding-check/2"
      ]
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "enum": [
        "A",
        "B"
      ]
    },
    "checked_at": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "enum": [
        "0.1.0",
        "unknown"
      ]
    },
    "version_evidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "enum": [
        "brew",
        "human_reported",
        "unknown"
      ]
    },
    "artifact_receipt": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "release_tag": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "enum": [
                "v0.1.0"
              ]
            },
            "archive_sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "enum": [
                "7f7218e467f2f913e73bbc20785caeb96bc9f63a916fdca4e217abcdd37deef9",
                "c8c48db2dab796790248115cc74b366c5be7ecba3bb9c40db9b308697297ac75"
              ]
            },
            "tap_commit": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[0-9a-f]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "enum": [
                "human_verified_release"
              ]
            },
            "formula_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "f01165bea5b6dfadfcdb57b3ed7f82eaa91478f026e7354df2663c45dd79bf2d"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "release_tag",
            "archive_sha256",
            "tap_commit",
            "source",
            "formula_sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "credential_class": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "enum": [
        "synthetic",
        "real"
      ]
    },
    "isolation_confirmed": {
      "type": "boolean"
    },
    "local_result": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "enum": [
        "pass",
        "blocked",
        "needs_human_install",
        "needs_human_receipt",
        "needs_human_runtime_config",
        "needs_human_settings",
        "needs_human_version"
      ]
    },
    "team_result": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "enum": [
        "pending_peer"
      ]
    },
    "checks": {
      "type": "object",
      "properties": {
        "agent_binary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "enum": [
            "pass",
            "failed",
            "unknown"
          ]
        },
        "runtime_config_present": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "enum": [
            "pass",
            "failed",
            "unknown"
          ]
        },
        "connection_visible": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "enum": [
            "pass",
            "failed",
            "unknown"
          ]
        },
        "readonly_request_exit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "service_http_status": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_response": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "enum": [
            "pass",
            "failed",
            "unknown"
          ]
        }
      },
      "required": [
        "agent_binary",
        "runtime_config_present",
        "connection_visible",
        "readonly_request_exit",
        "service_http_status",
        "expected_response"
      ],
      "additionalProperties": false
    },
    "connection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "probe": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "enum": [
            "GET"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expected_http_status": {
          "type": "integer",
          "minimum": 200,
          "maximum": 299
        },
        "expected_response_rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "method",
        "path",
        "expected_http_status",
        "expected_response_rule"
      ],
      "additionalProperties": false
    },
    "human_receipt": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "env_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "project": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-z0-9_.-]{1,96}$"
            },
            "environment": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-z0-9_.-]{1,96}$"
            },
            "self_fingerprint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-z2-7]{26}$"
            },
            "planned_A_fingerprint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-z2-7]{26}$"
            },
            "planned_B_fingerprint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-z2-7]{26}$"
            },
            "writes_paused_for_check": {
              "type": "boolean"
            },
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "fingerprint": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[a-z2-7]{26}$"
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "enum": [
                      "admin",
                      "user"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "enum": [
                      "active",
                      "removed"
                    ]
                  },
                  "owner": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "fingerprint",
                  "role",
                  "status",
                  "owner"
                ],
                "additionalProperties": false
              },
              "minItems": 2,
              "maxItems": 256
            },
            "status_samples": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sampled_at": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                  },
                  "vector": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 256,
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[a-z2-7]{26}$"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "commits_folded": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "skipped_ops": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "rejected_commits": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "pending_deferred": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "sampled_at",
                  "vector",
                  "commits_folded",
                  "skipped_ops",
                  "rejected_commits",
                  "pending_deferred"
                ],
                "additionalProperties": false
              },
              "minItems": 2,
              "maxItems": 2
            },
            "verification_session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-z0-9_.-]{1,96}$"
            },
            "writes_paused_since": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            }
          },
          "required": [
            "env_id",
            "project",
            "environment",
            "self_fingerprint",
            "planned_A_fingerprint",
            "planned_B_fingerprint",
            "writes_paused_for_check",
            "members",
            "status_samples",
            "verification_session_id",
            "writes_paused_since"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt_source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "enum": [
        "human_reported"
      ]
    },
    "failed_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[a-z0-9_.-]{1,96}$"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "human_next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[a-z0-9_.-]{1,96}$"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "observed_tap_commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_formula_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "installed_tap_commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "installed_spec": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "stable",
            "head"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "binaries_resolve_to_keg": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "role",
    "checked_at",
    "version",
    "version_evidence",
    "artifact_receipt",
    "credential_class",
    "isolation_confirmed",
    "local_result",
    "team_result",
    "checks",
    "connection_id",
    "probe",
    "human_receipt",
    "receipt_source",
    "failed_checks",
    "human_next_actions",
    "observed_tap_commit",
    "observed_formula_sha256",
    "installed_tap_commit",
    "installed_spec",
    "binaries_resolve_to_keg"
  ],
  "additionalProperties": false
}
